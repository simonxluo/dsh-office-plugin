{
  "name": "dsh-office-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness Office 工具包：agent 自助读写 Word(.docx)/Excel(.xlsx)/CSV 办公文档",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "office",
    "docx",
    "xlsx",
    "csv"
  ],
  "author": "simonxluo",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.3"
  }
}
